[global]
  monitor = 0
  follow = mouse
  width = 360
  height = 120
  origin = top-right
  offset = 14x44
  notification_limit = 5
  transparency = 8
  separator_height = 2
  padding = 12
  horizontal_padding = 12
  frame_width = 2
  corner_radius = 8
  font = JetBrainsMono Nerd Font 10
  markup = full
  format = "<b>%s</b>\n%b"
  icon_position = left
  min_icon_size = 32
  max_icon_size = 48

[urgency_low]
  background = "#0e0607"
  foreground = "#c2c0c1"
  frame_color = "#695555"
  timeout = 4

[urgency_normal]
  background = "#0e0607"
  foreground = "#c2c0c1"
  frame_color = "#E3223A"
  timeout = 6

[urgency_critical]
  background = "#0e0607"
  foreground = "#c2c0c1"
  frame_color = "#BC2135"
  timeout = 0
