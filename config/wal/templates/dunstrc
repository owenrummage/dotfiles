[global]
  monitor = 0
  follow = mouse
  width = 360
  height = 120
  origin = top-right
  offset = 14x44
  notification_limit = 5
  transparency = 8
  separator_height = 2
  padding = 12
  horizontal_padding = 12
  frame_width = 2
  corner_radius = 8
  font = JetBrainsMono Nerd Font 10
  markup = full
  format = "<b>%s</b>\n%b"
  icon_position = left
  min_icon_size = 32
  max_icon_size = 48

[urgency_low]
  background = "#101214"
  foreground = "#f4f7fb"
  frame_color = "{color12}"
  timeout = 4

[urgency_normal]
  background = "#101214"
  foreground = "#f4f7fb"
  frame_color = "{color9}"
  timeout = 6

[urgency_critical]
  background = "#101214"
  foreground = "#f4f7fb"
  frame_color = "{color11}"
  timeout = 0
