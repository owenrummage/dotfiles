#!/usr/bin/env bash
set -euo pipefail

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
total=$((user + nice + system + idle + iowait + irq + softirq + steal))
busy=$((total - idle - iowait))
cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/i3blocks-cpu"
cache_dir="$(dirname "$cache")"
mkdir -p "$cache_dir" 2>/dev/null || cache=""
if [[ -r "$cache" ]]; then
  read -r prev_total prev_busy < "$cache"
  delta_total=$((total - prev_total))
  delta_busy=$((busy - prev_busy))
  if (( delta_total > 0 )); then
    usage="$((100 * delta_busy / delta_total))"
  else
    usage=0
  fi
else
  usage=""
fi
if [[ -n "$cache" && -w "$cache_dir" ]]; then
  printf '%s %s\n' "$total" "$busy" > "$cache"
fi

if [[ -z "$usage" ]]; then
  printf 'C --%%\n\n#22c55e\n'
  exit 0
fi

color="#22c55e"
if (( usage >= 85 )); then
  color="#ef4444"
elif (( usage >= 60 )); then
  color="#eab308"
fi

printf 'C %d%%\n\n%s\n' "$usage" "$color"
